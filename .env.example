# ──────────────────────────────────────────────────────────────
# RentPilot Environment Variables
# Copy this file to .env.local for local development.
# The app runs fully in demo mode when these are left blank.
# ──────────────────────────────────────────────────────────────

# ─── Supabase (REQUIRED for production) ──────────────────────
# Found in Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, NEVER exposed to the browser.
# Required for payment webhook DB writes (bypasses RLS on webhook tables).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Application ─────────────────────────────────────────────
# Production URL (required for auth email redirects, payment return URLs).
# NEXT_PUBLIC_APP_URL=https://rentpilot.vercel.app

# ─── AI — Chat Interface (server-only) ───────────────────────
# Default: local Ollama at 127.0.0.1:11434 (development only).
# For production: set AI_BASE_URL to any OpenAI-compatible endpoint.
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.2

# ─── AI — Service Layer (server-only) ────────────────────────
# Used by rent reminders, classification, and insight features.
# OPENAI_API_KEY=sk-xxxxxxx
# OPENAI_MODEL=gpt-5-mini

# ─── Email (server-only) ─────────────────────────────────────
# Required to send real rent reminder emails in production.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=RentPilot <reminders@yourdomain.com>

# ─── Stripe (legacy — frozen; server-only) ───────────────────
# Stripe is frozen. Razorpay is the active payment provider.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# ─── Razorpay (server-only) ──────────────────────────────────
# Active rent collection provider for Indian landlords.
# PAYMENT_COLLECTION_PROVIDER=razorpay
# DEFAULT_CURRENCY=INR
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
