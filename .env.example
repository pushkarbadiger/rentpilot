# Copy this file to .env.local and fill in your own Supabase project
# credentials. RentPilot runs fully in "demo mode" with sample data when
# these are left blank, so you can develop the UI before connecting a
# real backend.

# Found in Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, NEVER exposed to the browser.
# Required for Stripe webhook processing (bypasses RLS on webhook tables).
# Not used by landlord-facing dashboard actions.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Reserved for a future AI provider (OpenAI, Anthropic, etc.).
# Not used by Phase 1 — see src/lib/services/ai for the integration point.
# AI_PROVIDER_API_KEY=

# Email reminders (server-only — never use NEXT_PUBLIC_* for these).
# Required to send real rent reminder emails in production.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=RentPilot <reminders@yourdomain.com>

# Stripe Connect (legacy — frozen; server-only).
# STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Rent collection provider (server-only configuration).
# PAYMENT_COLLECTION_PROVIDER=razorpay
# DEFAULT_CURRENCY=INR

# Razorpay rent collection (server-only — not used until P2.8I).
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxx
